<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.view.LoginController"
      alignment="CENTER" spacing="16"
      style="-fx-background-color: #f4f4f4;">

    <padding><Insets top="50" right="60" bottom="50" left="60"/></padding>

    <Label text="Fleet Manager" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #5c2d91;"/>

    <VBox spacing="6">
        <Label text="Brugernavn"/>
        <TextField fx:id="usernameField" promptText="Brugernavn"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Password"/>
        <PasswordField fx:id="passwordField" promptText="Password"/>
    </VBox>

    <Label fx:id="errorLabel" style="-fx-text-fill: red; -fx-font-size: 12;"/>

    <Button text="Log ind" onAction="#onLoginClick"
            style="-fx-background-color: #5c2d91; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 8 24;"
            maxWidth="Infinity"/>
</VBox>
